{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="auth-container">
        <h1 class="auth-title">Inscription</h1>

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="auth-alert" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, { attr: { class: 'auth-form' } }) }}
            {{ form_row(registrationForm.email, {
                row_attr: { class: 'auth-field' },
                attr: { class: 'auth-input' }
            }) }}
            {{ form_row(registrationForm.plainPassword, {
                label: 'Mot de passe',
                row_attr: { class: 'auth-field' },
                attr: { class: 'auth-input' }
            }) }}

            <div class="auth-actions">
                <button type="submit" class="auth-btn">Creer le compte</button>
            </div>
        {{ form_end(registrationForm) }}

        <p class="auth-help">
            Deja un compte ? <a class="auth-link" href="{{ path('app_login') }}">Connexion</a>
        </p>
    </div>
{% endblock %}
