{% extends 'base.html.twig' %}

{% block title %}Inscription - Foot Local{% endblock %}

{% block body %}
<div class="registration-container" style="max-width: 450px; margin: 40px auto; padding: 25px; background-color: #F9F3E8; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <h1 style="color: #206448; text-align: center; margin-bottom: 25px;">Créer un compte</h1>
    
    <form action="{{ path('app_login') }}" method="get"> {# Redirige vers login après validation mockée #}
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Nom complet</label>
            <input type="text" name="name" placeholder="Jean Dupont" required style="width: 100%; padding: 10px; border: 1px solid #D9D9D9; border-radius: 4px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Email</label>
            <input type="email" name="email" placeholder="jean.dupont@m2l.fr" required style="width: 100%; padding: 10px; border: 1px solid #D9D9D9; border-radius: 4px;">
        </div>
        
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Mot de passe</label>
            <input type="password" name="password" required style="width: 100%; padding: 10px; border: 1px solid #D9D9D9; border-radius: 4px;">
        </div>

        <button type="submit" style="width: 100%; padding: 12px; background-color: #206448; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 16px;">
            S'inscrire
        </button>
    </form>

    <div style="margin-top: 20px; text-align: center;">
        <p>Déjà membre ? <a href="{{ path('app_login') }}" style="color: #206448; font-weight: bold;">Connectez-vous</a></p>
    </div>
</div>
{% endblock %}