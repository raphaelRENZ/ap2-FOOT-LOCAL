{# Header de l'application - Maison des Ligues #}
<header class="main-header">
    {# Logo cliquable #}
    <div class="header-logo">
        <a href="{{ path('app_home') }}" class="logo-link">
            <img src="{{ asset('assets/images/logo.png') }}" alt="Maison des Ligues - Foot Local" class="logo-img">
        </a>
    </div>
    
    {# Navigation principale #}
    <nav class="header-nav">
        <a href="{{ path('app_tournois') }}" class="nav-btn">Tournois</a>
        <a href="{{ path('app_clubs') }}" class="nav-btn">Club</a>
        <a href="{{ path('app_contact') }}" class="nav-btn">Contact</a>
        {% if app.user %}
            <a href="{{ path('app_compte') }}" class="nav-btn">Compte</a>
            <a href="{{ path('app_logout') }}" class="nav-btn">Deconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="nav-btn">Connexion</a>
        {% endif %}
    </nav>
</header>
