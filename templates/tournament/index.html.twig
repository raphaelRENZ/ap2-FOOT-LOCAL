{% extends 'base.html.twig' %}

{% block title %}Tournois - Foot Local{% endblock %}

{% block body %}
    <div class="hero-section">
        <h1>Liste des tournois</h1>
    </div>

    {% if tournois is not empty %}
        <div class="content-grid">
            {% for tournoi in tournois %}
                <div class="content-card">
                    <h2>{{ tournoi.nom }}</h2>
                    <p>Date de début : {{ tournoi.date_debut }}</p>
                    <a href="{{ path('app_tournois_detail', {id: tournoi.id}) }}" class="btn btn-primary">Voir les détails</a>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="content-card">
            <p>Aucun tournoi disponible pour le moment.</p>
        </div>
    {% endif %}
{% endblock %}
