{% extends 'base.html.twig' %}

{% block title %}Mes clubs favoris - Foot Local{% endblock %}

{% block body %}
    <div class="hero-section">
        <h1>Mes clubs favoris</h1>
    </div>

    {% if clubsFavoris is not empty %}
        <div class="content-card">
            <table class="table mt-4">
                <thead>
                    <tr>
                        <th>Club</th>
                        <th>Ville</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for club in clubsFavoris %}
                        <tr>
                            <td>
                                <a href="{{ path('app_clubs_detail', {id: club.id}) }}">
                                    {{ club.name }}
                                </a>
                            </td>
                            <td>
                                {{ club.city }}{% if club.country %}, {{ club.country }}{% endif %}
                            </td>
                            <td>
                                <form method="post" action="{{ path('app_clubs_toggle_favori', {id: club.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_favori_' ~ club.id) }}">
                                    <button type="submit" style="padding:.3rem .8rem; border:2px solid #ef4444; border-radius:6px; background:#fee2e2; color:#991b1b; font-weight:600; cursor:pointer;">− Retirer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="content-card">
            <p>Vous n'avez pas encore de clubs favoris ? <a href="{{ path('app_clubs_index') }}">Découvrez les clubs disponibles et ajoutez-en à vos favoris</a>.</p>
        </div>
    {% endif %}
{% endblock %}
