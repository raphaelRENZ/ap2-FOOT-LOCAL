{% extends 'base.html.twig' %}

{% block title %}Contact - Foot Local{% endblock %}

{% block body %}
<div class="container">
    <h1>Nous contacter</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <h2>Formulaire de contact</h2>
            <form method="post">
                <div class="mb-3">
                    <label for="nom" class="form-label">Nom</label>
                    <input type="text" class="form-control" id="nom" name="nom" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">Message</label>
                    <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Envoyer</button>
            </form>
        </div>

        <div class="col-md-6">
            <h2>Nos coordonnées</h2>
            <address>
                <strong>{{ coordonnees.adresse }}</strong><br>
                Téléphone : {{ coordonnees.telephone }}<br>
                Email : <a href="mailto:{{ coordonnees.email }}">{{ coordonnees.email }}</a>
            </address>
        </div>
    </div>

    <a href="{{ path('app_home') }}" class="btn btn-secondary mt-3">Retour à l'accueil</a>
</div>
{% endblock %}
