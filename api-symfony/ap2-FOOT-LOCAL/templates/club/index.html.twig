{% extends 'base.html.twig' %}

{% block title %}Clubs - Foot Local{% endblock %}

{% block body %}
    <div class="hero-section">
        <h1>Liste des clubs</h1>
    </div>

    {% if clubs is not empty %}
        <div class="content-card">
            <table class="table mt-4">
                <thead>
                    <tr>
                        <th>Nom du club</th>
                        <th>Ville</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for club in clubs %}
                        <tr>
                            <td>{{ club.nom }}</td>
                            <td>{{ club.ville }}</td>
                            <td>
                                <a href="{{ path('app_clubs_detail', {id: club.id}) }}" class="btn btn-sm btn-primary">Voir détails</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="content-card">
            <p>Aucun club enregistré pour le moment.</p>
        </div>
    {% endif %}
{% endblock %}
