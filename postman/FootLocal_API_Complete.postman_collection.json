    {
      "name": "👤 UTILISATEURS",
      "item": [
        {
          "name": "GET /api/users/me – Profil connecté",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 – Profil récupéré', () => pm.response.to.have.status(200));",
              "pm.test('Données complètes du profil', () => {",
              "    const data = pm.response.json().data;",
              "    pm.expect(data).to.have.all.keys('id','email','firstName','lastName','roles','phone','avatar','isVerified','favoriteClubs');",
