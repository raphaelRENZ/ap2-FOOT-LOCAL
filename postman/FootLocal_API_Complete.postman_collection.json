{
  "info": {
    "name": "Foot Local – API Complète",
    "_postman_id": "foot-local-api-complete",
    "description": "Tests complets de toutes les routes API : Auth, Clubs, Joueurs, Matchs, Tournois, Utilisateurs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:8000" },
    { "key": "jwt_token",  "value": "" },
    { "key": "club_id",    "value": "1" },
    { "key": "player_id",  "value": "1" },
    { "key": "match_id",   "value": "1" },
    { "key": "tournament_id", "value": "1" },
    { "key": "user_id",    "value": "1" }
  ],
  "item": [

    {
      "name": "🔐 AUTH",
      "item": [
        {
          "name": "POST /api/login – Connexion admin",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 – Connexion réussie', () => pm.response.to.have.status(200));",
              "pm.test('Token JWT présent', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "    pm.collectionVariables.set('jwt_token', json.token);",
              "    console.log('✅ Token JWT sauvegardé');",
              "});",
              "pm.test('Payload contient ROLE_ADMIN', () => {",
              "    const payload = JSON.parse(atob(pm.response.json().token.split('.')[1]));",
              "    pm.expect(payload.roles).to.include('ROLE_ADMIN');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@footlocal.com\",\n  \"password\": \"admin1234\"\n}" }
          }
        },
        {
          "name": "POST /api/login – Mauvais mot de passe → 401",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('401 – Mauvaises credentials', () => pm.response.to.have.status(401));",
              "pm.test('Message d\\'erreur présent', () => pm.expect(pm.response.json()).to.have.property('message'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@footlocal.com\",\n  \"password\": \"mauvais_mdp\"\n}" }
          }
        },
        {
          "name": "POST /api/login – Email inexistant → 401",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('401 – Utilisateur inexistant', () => pm.response.to.have.status(401));"
            ]}
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"inconnu@test.fr\",\n  \"password\": \"test\"\n}" }
          }
        }
      ]
    },

    {
      "name": "🏟️ CLUBS",
      "item": [
        {
          "name": "GET /api/clubs – Liste tous les clubs",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 – Liste des clubs OK', () => pm.response.to.have.status(200));",
              "pm.test('status = success', () => pm.expect(pm.response.json().status).to.eql('success'));",
              "pm.test('data est un tableau non vide', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.be.an('array').and.not.empty;",
              "    pm.expect(json).to.have.property('total');",
              "    pm.collectionVariables.set('club_id', json.data[0].id);",
              "    console.log('Nombre de clubs :', json.total, '| Premier ID sauvegardé :', json.data[0].id);",
              "});",
              "pm.test('Champs attendus présents', () => {",
              "    const club = pm.response.json().data[0];",
              "    pm.expect(club).to.have.all.keys('id','name','city','country','stadium','logo','description','founded_year','colors');",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/clubs"
          }
        },
        {
          "name": "GET /api/clubs/:id – Détail d'un club",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 – Club trouvé', () => pm.response.to.have.status(200));",
              "pm.test('Champs détaillés présents', () => {",
              "    const data = pm.response.json().data;",
              "    pm.expect(data).to.have.property('players');",
              "    pm.expect(data.players).to.be.an('array');",
              "    console.log('Club :', data.name, '| Joueurs :', data.players.length);",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/clubs/{{club_id}}"
          }
        },
        {
          "name": "GET /api/clubs/999 – Club inexistant → 404",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('404 – Club not found', () => pm.response.to.have.status(404));",
              "pm.test('Message d\\'erreur correct', () => pm.expect(pm.response.json().message).to.include('not found'));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/clubs/999"
          }
        }
      ]
    },

