{% extends 'base.html.twig' %}

{% block title %}Modifier {{ tournoi.name }} - Admin{% endblock %}

{% block body %}
    <div class="hero-section">
        <h1>🏆 Modifier le tournoi</h1>
        <p><a href="{{ path('app_admin_tournois_index') }}" style="color:rgba(255,255,255,.8);">← Retour à la liste</a></p>
    </div>

    <div class="content-card" style="max-width:700px;">
        <form method="post" action="{{ path('app_admin_tournois_edit', {id: tournoi.id}) }}">
            {% include 'admin/tournois/_form.html.twig' with {tournoi: tournoi} %}
            <div style="margin-top:20px;display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_admin_tournois_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
{% endblock %}
