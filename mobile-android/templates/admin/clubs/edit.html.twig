{% extends 'base.html.twig' %}

{% block title %}Modifier {{ club.name }} - Admin{% endblock %}

{% block body %}
    <div class="hero-section">
        <h1>⚽ Modifier le club</h1>
        <p><a href="{{ path('app_admin_clubs_index') }}" style="color:rgba(255,255,255,.8);">← Retour à la liste</a></p>
    </div>

    <div class="content-card" style="max-width:700px;">
        <form method="post" action="{{ path('app_admin_clubs_edit', {id: club.id}) }}">
            {% include 'admin/clubs/_form.html.twig' with {club: club} %}
            <div style="margin-top:20px;display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_admin_clubs_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
{% endblock %}
