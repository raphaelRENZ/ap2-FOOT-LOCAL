{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth-container">
        <h1 class="auth-title">Connexion</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 12px; margin-bottom: 16px; border-radius: 4px;">
                {{ message }}
            </div>
        {% endfor %}

        {% if error %}
            <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <p class="auth-help">
                Connecte en tant que {{ app.user.userIdentifier }}. <a class="auth-link" href="{{ path('app_logout') }}">Deconnexion</a>
            </p>
        {% endif %}

        <form method="post" class="auth-form">
            <div class="auth-field">
                <label for="username">Email</label>
                <input
                    type="email"
                    value="{{ last_username }}"
                    name="_username"
                    id="username"
                    class="auth-input"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div class="auth-field">
                <label for="password">Mot de passe</label>
                <input
                    type="password"
                    name="_password"
                    id="password"
                    class="auth-input"
                    autocomplete="current-password"
                    required
                >
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="auth-actions">
                <button class="auth-btn" type="submit">Se connecter</button>
            </div>
        </form>

        <p class="auth-help">
            Pas encore de compte ? <a class="auth-link" href="{{ path('app_register') }}">Inscription</a>
        </p>
    </div>
{% endblock %}
